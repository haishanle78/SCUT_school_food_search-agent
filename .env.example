# ============================================================================
#  干饭军师 · 配置模板
#  用法：复制本文件为 .env，然后只改带【要你填】的三行。
#  唯一配置源：进程环境变量 > .env > 代码默认值，没有第二层覆盖文件。
#
#  多把凭据的填写规则：用【英文逗号】写在同一行，顺序随意，前后空格无所谓；
#  不要换行分隔，不要用中文逗号（，）。重复的会自动去掉。
# ============================================================================

# ---------- 大模型：智谱 GLM-4-Flash（OpenAI 兼容协议）----------
LLM_PROVIDER=openai
LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 【要你填】智谱 API Key
#   1 把： OPENAI_API_KEYS=abc123
#   4 把： OPENAI_API_KEYS=abc123,def456,ghi789,jkl012
OPENAI_API_KEYS=key1,key2,key3,key4

# LLM Key 池与并发治理
# glm-4-flash 免费档：单 Key 并发很低，上下文超 8K token 速率还会大幅受限。
LLM_CONCURRENCY_PER_KEY=2      # 单 Key 并发路数（免费档建议 1~2，调大换来 429）
LLM_QUEUE_WAIT=20              # 排队等待上限（秒），超时返回"稍后再试"
LLM_BREAKER_COOLDOWN=120       # Key 被限流后的熔断时长（秒），期间自动换下一把
LLM_CONTEXT_CHAR_LIMIT=14000   # 上下文字符预算（messages+tools），超限主动裁剪防 8K 限速
TOOL_RESULT_MAX_CHARS=600      # 裁剪时单条工具结果保留长度

# DeepSeek 备选（付费，效果更稳；启用时把上面三行改成下面这样）
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEYS=key1,key2

# ---------- 出发点（5 个校门/宿舍区坐标均为 2026-11-10 百度实测）----------
CAMPUS_LOCATION=23.017973,113.411971
ORIGIN_KEY=dorm

# ---------- 百度地图：多 AK 池 ----------
# 【要你填】百度地图 AK，每个都必须是【服务端】类型应用、且不勾 SN 校验
#   1 把： BAIDU_MAP_AKS=abcdefg
#   4 把： BAIDU_MAP_AKS=ak1,ak2,ak3,ak4
# 池子总容量 = 每把 AK 的日配额 × AK 数量
BAIDU_MAP_AKS=ak1,ak2,ak3,ak4

# ---------- 地图治理（默认已按个人开发者额度留余量）----------
MAP_QPS=2
MAP_DAILY_SEARCH=80
MAP_DAILY_ROUTE=4000
MAP_TIMEOUT=8
MAP_MAX_WAIT=4
MAP_RETRY=1
MAP_AUTH_COOLDOWN=600
MAP_CACHE_TTL_SEARCH=600
MAP_CACHE_TTL_ROUTE=600

# ---------- 接口安全 ----------
MAX_MESSAGE_CHARS=400
CHAT_RATE_PER_MIN=8
CHAT_GLOBAL_DAILY=300
MAX_TOOL_CALLS_PER_TURN=10

# ---------- 天气（复用百度 AK；没有 AK 时自动关闭，不影响查店与推荐）----------
# WEATHER_DISTRICT_ID=440113    # 番禺区行政区划代码
# WEATHER_TIMEOUT=6
# WEATHER_CACHE_TTL=1800

# ---------- 知识库 ----------
# KB_MIN_SAMPLES=3              # 少于该样本数只报条数，不显示均值
# KB_DEMO=0                     # 1 = 读演示语料（仓库不附带，需自备目录）
# KB_DEMO_DIR=data/examples
