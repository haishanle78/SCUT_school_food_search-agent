# ===== 模型（二选一，复制本文件为 .env 后填写）=====
# 智谱 GLM-4-Flash（当前线上使用，模型免费；联网搜索等工具另有定价）
LLM_PROVIDER=openai
OPENAI_API_KEY=在此填入你的key
LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ===== LLM Key 池与并发治理（多 Key 分流，容量线性扩展）=====
# 逗号分隔填多把 Key；只填一把时等价于单 Key 模式。
# glm-4-flash 免费档：单 Key 并发 2；上下文超 8K token 速率大幅受限。
# OPENAI_API_KEYS=key1,key2,key3,key4
LLM_CONCURRENCY_PER_KEY=2      # 单 Key 并发路数
LLM_QUEUE_WAIT=10              # 排队等待上限（秒），超时返回"稍后再试"
LLM_BREAKER_COOLDOWN=600       # Key 限流后的熔断时长（秒）
LLM_CONTEXT_CHAR_LIMIT=14000   # 上下文字符预算（messages+tools），超限主动裁剪防 8K 限速
TOOL_RESULT_MAX_CHARS=600      # 裁剪时单条工具结果保留长度

# DeepSeek（付费，效果更稳）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=在此填入你的key
# DEEPSEEK_API_KEYS=key1,key2
# LLM_MODEL=deepseek-chat

# ===== 出发点（5 个校门/宿舍区坐标均为 2026-11-10 百度实测）=====
CAMPUS_LOCATION=23.017973,113.411971
ORIGIN_KEY=dorm

# ===== 百度地图（服务端类型应用，不勾 SN 校验；白名单可留空）=====
# 多 AK 分流：逗号分隔。池子总容量 = 每把 AK 的日配额 × AK 数量。
BAIDU_MAP_AK=
# BAIDU_MAP_AKS=ak1,ak2,ak3,ak4

# ===== 地图治理（默认已按个人开发者额度留余量）=====
MAP_QPS=2
MAP_DAILY_SEARCH=80
MAP_DAILY_ROUTE=4000
MAP_TIMEOUT=8
MAP_MAX_WAIT=4
MAP_RETRY=1
MAP_AUTH_COOLDOWN=600
MAP_CACHE_TTL_SEARCH=600
MAP_CACHE_TTL_ROUTE=600

# ===== 接口安全 =====
MAX_MESSAGE_CHARS=400
CHAT_RATE_PER_MIN=8
CHAT_GLOBAL_DAILY=300
MAX_TOOL_CALLS_PER_TURN=10

# ===== 云端用平台环境变量注入密钥时打开（让平台值优先于 runtime.env）=====
# USE_PLATFORM_ENV=1
